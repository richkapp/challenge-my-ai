# Challenge My AI environment
#
# Local/preview mode works without provider secrets and uses the in-memory local adapter.
# Real production mode fails closed unless Supabase Auth, Postgres, and signed agent auth are configured.

# local | preview | production | test
CMAI_RUNTIME_ENV=local

# Optional overrides. Production must use supabase + postgres.
CMAI_AUTH_MODE=local
CMAI_STORE_DRIVER=local

# Only honored outside production. Enables explicit non-durable preview accounts on /login.
# Do not use this for live production accounts.
CMAI_ENABLE_DEMO_AUTH=1

# Required for production agent API requests. Agents sign `${agentId}.${timestamp}` with HMAC-SHA256.
CMAI_AGENT_API_SECRET=

# Production Postgres/Supabase Auth
# Google login is configured in the Supabase dashboard under Authentication > Providers > Google.
# Redirect/callback URL should point to /api/auth/callback on the deployed app.
# Set this only after Google OAuth is configured and live smoke passes.
CMAI_GOOGLE_AUTH_ENABLED=
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production data / rollback dry-run
# Prints redacted readiness and placeholder backup/restore/rollback commands only; it does not touch production.
# Set CMAI_VERCEL_PROJECT_LINKED=1 only for the intended linked Vercel project/rollback target.
# bun run check:production-data -- --markdown
CMAI_VERCEL_PROJECT_LINKED=

# Trusted Agent run production prerequisites. Keep production trusted runs fail-closed until durable Railway Sandbox auth is solved.
CMAI_RECEIPT_SIGNING_KEY_ID=
CMAI_RECEIPT_SIGNING_SECRET=
CMAI_AGENT_BROKER_VAULT_MODE=
CMAI_AGENT_BROKER_VAULT_URL=
CMAI_AGENT_BROKER_VAULT_SECRET=
CMAI_MODEL_PROXY_URL=
CMAI_MODEL_PROXY_GRANT_STORE=
RAILWAY_API_TOKEN=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_SANDBOX_CHECKPOINT=
# api_token is proof-only unless Sandbox.create accepts a non-expiring credential; oauth_refresh is future/broker-side and not implemented yet.
RAILWAY_SANDBOX_AUTH_MODE=
RAILWAY_OAUTH_REFRESH_TOKEN=

# AI/provider adapters
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Billing
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRIVATE_CHALLENGE=

# Analytics / observability
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
TRIGGER_SECRET_KEY=
